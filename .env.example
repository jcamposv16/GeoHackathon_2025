LLM_NAME=llama3.2
MODEL_EMBED=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=6

# Optional overrides. If unset, both default to a folder inside the project
# (GeoHackathon_vector_db/ and GeoHackathon_pdf_cache/ next to src/).
# Set these if you want the vector DB or PDF cache stored elsewhere.
VECTOR_DB_DIR=C:/Users/you/GeoHackathon_vector_db
PDF_CACHE_DIR=C:/Users/you/GeoHackathon_pdf_cache
